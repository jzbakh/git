+void probe_attrs(const char *what, const wchar_t *wname, size_t wlen,
+		 DWORD attr, DWORD tag, const LARGE_INTEGER *c,
+		 const LARGE_INTEGER *w, const LARGE_INTEGER *ch)
+{
+	typedef CHAR (NTAPI *q_fn)(void);
+	static q_fn qp, qt;
+	static int init;
+
+	if (!_wgetenv(L"GIT_PROBE_ATTRS"))
+		return;
+	if (!init) {
+		HMODULE nt = GetModuleHandleW(L"ntdll.dll");
+		FARPROC p;
+
+		p = GetProcAddress(nt,
+			"RtlQueryProcessPlaceholderCompatibilityMode");
+		memcpy(&qp, &p, sizeof(qp));
+		p = GetProcAddress(nt,
+			"RtlQueryThreadPlaceholderCompatibilityMode");
+		memcpy(&qt, &p, sizeof(qt));
+		init = 1;
+	}
+	fprintf(stderr, "probe %-7s %.*ls attr=0x%08lx tag=0x%08lx"
+		" C=%lld W=%lld Ch=%lld Ch>max(C,W)=%d pmode=%d tmode=%d"
+		" tid=%lu\n", what, (int)wlen, wname, (unsigned long)attr,
+		(unsigned long)tag, (long long)c->QuadPart,
+		(long long)w->QuadPart, (long long)ch->QuadPart,
+		ch->QuadPart > c->QuadPart && ch->QuadPart > w->QuadPart,
+		qp ? (int)qp() : -100, qt ? (int)qt() : -100,
+		(unsigned long)GetCurrentThreadId());
+}
